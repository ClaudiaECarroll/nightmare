": 842, "n": "Emmeline"}, {"c": 415, "n": "Delamere"}, {"c": 357, "n": "Mrs. Stafford"}, {"c": 350, "n": "Lord Montreville"}, {"c": 15, "n": "Stafford"}, {"c": 10, "n": "Montreville"}, {"c": 3, "n": "Mrs Stafford"}, {"c": 2, "n": "the innocent Emmeline"}, {"c": 2, "n": "the happy Delamere"}, {"c": 2, "n": "poor Delamere"}, {"c": 1, "n": "Emmeline , who had from her earliest remembrance been accustomed only to the plainest dress , and the most simple and sober manners , the figure and deportment of this woman appeared equally extraordinary"}, {"c": 1, "n": "Delamere , who was really captivated at the first , and who now thought her more beautiful than he had done in their former interviews"}, {"c": 1, "n": "whither Delamere"}, {"c": 1, "n": "Emmeline , who had stood trembling the whole time behind Lord Montreville"}, {"c": 1, "n": "Mrs. Stafford , who believed he did not know her , took very little notice ; and turning towards Emmeline , who had in the mean time been listening in trembling apprehension to the ardent declarations of Delamere"}, {"c": 1, "n": "Mrs. Stafford , who saw Emmeline ready to sink with the apprehension of being seen walking with Delamere , intreated the gentlemen to leave them and go to Lord Montreville"}, {"c": 1, "n": "Augusta Delamere"}, {"c": 1, "n": "Emmeline , who shuddered at the picture he had drawn of his despair , and saw such traces of its reality on his countenance"}, {"c": 1, "n": "Emmeline , who had wept excessively , was very unfit to return to the company"}, {"c": 1, "n": "My Lord Montreville , who is not obliged to give you the least assistance , or support , or countenance , does by me declare , that if you are so weak ( to call it by no harsher name ) as to refuse this astonishing , and amazing , and singular good fortune"}, {"c": 1, "n": "the unhappy Emmeline"}, {"c": 1, "n": "the dejected Emmeline"}, {"c": 1, "n": "Delamere , who from what had passed the evening before had indulged , during the night , the fondest dreams of happiness"}, {"c": 1, "n": "Emmeline ( whom he could never induce to own that her partiality for him"}, {"c": 1, "n": "The poor distrest Emmeline"}, {"c": 1, "n": "Delamere , who saw how much it soothed and relieved her , did not object to it"}, {"c": 1, "n": "Delamere , who watched his looks as if his existence depended upon his opinion"}, {"c": 1, "n": "rob Delamere"}, {"c": 1, "n": "the unprotected and unsuspicious Emmeline"}, {"c": 1, "n": "that Mrs. Stafford"}, {"c": 1, "n": "the unfortunate Stafford"}, {"c": 1, "n": "Lord Montreville , who must already have waited for him , he made a cold bow and hastened out of the room"}, {"c": 1, "n": "Mrs. Stafford partook"}, {"c": 1, "n": "the unfortunate Delamere"}, {"c": 1, "n": "the fortunate Delamere"}, {"c": 1, "n": "Emmeline , who incapable as she was of hating any body , yet felt towards him a disgust almost amounting to hatred"}, {"c": 1, "n": "Emmeline , who knew well on what he had so earnestly desired to meet him"}, {"c": 1, "n": "the unhappy Delamere"}, {"c": 1, "n": "headlong Delamere"}, {"c": 1, "n": "Emmeline , who saw fury in the eyes of Delamere , now wished as much to linger behind as she had before done to hurry forward"}], "common": [], "pronoun": [{"c": 1110, "n": "her"}, {"c": 689, "n": "she"}, {"c": 226, "n": "I"}, {"c": 105, "n": "She"}, {"c": 94, "n": "you"}, {"c": 81, "n": "herself"}, {"c": 80, "n": "my"}, {"c": 76, "n": "me"}, {"c": 39, "n": "your"}, {"c": 29, "n": "himself"}, {"c": 19, "n": "Her"}, {"c": 9, "n": "yourself"}, {"c": 7, "n": "My"}, {"c": 5, "n": "You"}, {"c": 2, "n": "tho"}, {"c": 2, "n": "myself"}, {"c": 2, "n": "Your"}, {"c": 1, "n": "it"}]}}, {"agent": [{"w": "treasured", "i": 126}, {"w": "cease", "i": 155}, {"w": "bore", "i": 246}, {"w": "doubt", "i": 3233}, {"w": "recollect", "i": 3236}, {"w": "hope", "i": 3272}, {"w": "reside", "i": 3251}, {"w": "continue", "i": 3268}, {"w": "hope", "i": 3272}, {"w": "lost", "i": 3294}, {"w": "had", "i": 4470}, {"w": "suppose", "i": 4513},